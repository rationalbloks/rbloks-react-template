# ============================================================================
# VITE BUILD VARIABLES
# ============================================================================
# What `npm run dev` and `npm run build` read. A module deployed by rationalbloks takes them from
# the module's variables instead. VITE_DATABASE_API_URL is required: your API's URL.
VITE_DATABASE_API_URL=https://api.example.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com


# ============================================================================
# CUSTOM VARIABLES
# ============================================================================
# Add app-specific VITE_* variables below.
# Must match vite_args in frontblok.config.json.
